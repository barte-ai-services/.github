{
  "name": "@barte-ai-services/handbook-mcp",
  "private": true,
  "description": "The engineering handbook as a read-only MCP server",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "node scripts/content.mjs",
    "build": "node scripts/content.mjs && node scripts/build.mjs",
    "dev": "node scripts/content.mjs && tsx src/local.ts",
    "test": "node scripts/content.mjs && vitest run",
    "typecheck": "node scripts/content.mjs && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
